# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# custom
# Raw upstream data drops, kept outside the tree for the same reason as
# data/leads/incoming below. Superseded by data/leads/incoming/<build>/ — these
# are historical and can be deleted once you are sure.
pilot-*
lead-console-instructions
handoff-*
package-v*

# Throwaway diagnostic scripts. Nothing here is ever part of the build.
.scratch/

# The lead corpus: REAL contact data for 15,274 congregations. This repository is
# public, so the payload never enters history — it is published to Vercel Blob and
# `data/leads/published.json` (committed) names the build production must serve.
# See data/leads/README.md.
/data/leads/incoming/
/data/leads/pack/