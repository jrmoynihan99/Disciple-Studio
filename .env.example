# Copy to .env.local for development, and set the same names in your host's
# environment for production. Values here are placeholders — never commit real ones.
#
# .gitignore covers `.env` and `.env.local`. This file is deliberately tracked so
# a new checkout can see what production needs without guessing.

# ── auth ─────────────────────────────────────────────────────────────────────
# proxy.ts gates /leads, /studio, /admin and the leads API with HTTP Basic auth.
# It FAILS CLOSED: with no password set, every gated route returns 401.
STUDIO_USER=admin
STUDIO_PASSWORD=

# Signs the per-device identity cookie that keys each user's export batches.
# SET THIS EXPLICITLY IN PRODUCTION. identity.ts falls back to STUDIO_PASSWORD,
# which means user ids are derived from the password — so rotating the password
# would silently orphan every batch anyone has collected.
LEADS_ID_SECRET=

# ── the lead corpus, on Cloudflare R2 ────────────────────────────────────────
# TWO BUCKETS, and the split is not cosmetic: R2's public access is a per-bucket
# setting. The data bucket holds names, emails and phone numbers for 15,274
# congregations and must NEVER be made public. The logos bucket holds sha256-named
# thumbnails that identify nothing on their own, and may be put behind a CDN.
R2_ACCOUNT_ID=
R2_BUCKET_DATA=disciple-studio-leads
R2_BUCKET_LOGOS=disciple-studio-logos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Which build the app serves is decided by data/leads/published.json, which is
# COMMITTED — not by anything here. Run `npm run leads:publish` against this
# account and commit the receipt it writes.

# ── demo generation, still on Vercel Blob ────────────────────────────────────
# Church demo configs, uploaded demo logos, import groups, and lead export
# batches. Small and mutable — a few objects per demo — which is what Blob is
# good at. The lead corpus is not: 14,511 objects per publish is several times
# the Hobby month's allowance of "advanced operations", and exceeding it
# suspends the whole store for ~30 days. That is why the corpus is on R2.
BLOB_READ_WRITE_TOKEN=

# ── local only ───────────────────────────────────────────────────────────────
# Where `npm run leads:pack` writes and the app reads. Defaults to
# data/leads/pack; the app uses it whenever it exists, and R2 otherwise.
# LEADS_PACK_DIR=data/leads/pack

# Force a source instead of auto-detecting. `r2` is how a publish gets verified
# locally before the receipt is committed.
# LEADS_DATASET_SOURCE=r2
