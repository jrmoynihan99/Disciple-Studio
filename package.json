{
  "name": "disciple-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --max-old-space-size=6144 --test \"lib/leads/**/*.test.mts\"",
    "lint:leads": "eslint --no-error-on-unmatched-pattern lib/leads scripts proxy.ts \"app/(studio)/leads/**\" \"app/(studio)/api/leads/**\"",
    "verify": "next typegen && npm run lint:leads && tsc --noEmit && npm test",
    "leads:copy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --max-old-space-size=6144 scripts/leads-copy-inventory.mts",
    "leads:gen": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/leads-gen-vocab.mts",
    "leads:pack": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --max-old-space-size=6144 scripts/leads-pack.mts",
    "leads:publish": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/leads-publish.mts"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.0",
    "@vercel/blob": "^2.5.0",
    "aws4fetch": "^1.0.20",
    "dompurify": "^3.4.13",
    "framer-motion": "^12.42.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.21.0",
    "next": "16.2.6",
    "next-view-transitions": "^0.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
